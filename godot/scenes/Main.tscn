[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/Main.gd" id="1_main"]
[ext_resource type="Script" path="res://scripts/PlayerController.gd" id="2_player"]
[ext_resource type="Script" path="res://scripts/GridMovementController.gd" id="3_movement"]

[node name="Main" type="Node2D"]
script = ExtResource("1_main")

[node name="World" type="Node2D" parent="."]

[node name="Player" type="Node2D" parent="."]
position = Vector2(168, 168)
script = ExtResource("2_player")

[node name="Camera2D" type="Camera2D" parent="Player"]
position = Vector2(0, 0)
position_smoothing_enabled = true
position_smoothing_speed = 6.0
limit_left = 0
limit_top = 0
limit_right = 1248
limit_bottom = 768
limit_smoothed = true

[node name="GridMovementController" type="Node2D" parent="."]
script = ExtResource("3_movement")

[node name="CombatHUD" type="CanvasLayer" parent="."]

[node name="Panel" type="PanelContainer" parent="CombatHUD"]
offset_left = 18.0
offset_top = 18.0
offset_right = 430.0
offset_bottom = 500.0

[node name="Margin" type="MarginContainer" parent="CombatHUD/Panel"]
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 10

[node name="VBox" type="VBoxContainer" parent="CombatHUD/Panel/Margin"]

[node name="Status" type="Label" parent="CombatHUD/Panel/Margin/VBox"]
text = "Game Core: conectando..."

[node name="Target" type="Label" parent="CombatHUD/Panel/Margin/VBox"]
text = "Alvo: nenhum"

[node name="StartCombat" type="Button" parent="CombatHUD/Panel/Margin/VBox"]
text = "Iniciar combate"

[node name="Attack" type="Button" parent="CombatHUD/Panel/Margin/VBox"]
text = "Atacar alvo"

[node name="CoupDeGrace" type="Button" parent="CombatHUD/Panel/Margin/VBox"]
text = "Golpe de Misericórdia"

[node name="EndTurn" type="Button" parent="CombatHUD/Panel/Margin/VBox"]
text = "Encerrar turno"

[node name="ActionLog" type="Label" parent="CombatHUD/Panel/Margin/VBox"]
custom_minimum_size = Vector2(0, 280)
autowrap_mode = 2
text = "REGISTRO DE AÇÕES\nNenhuma ação registrada."

[node name="DebugOverlay" type="CanvasLayer" parent="."]

[node name="Label" type="Label" parent="DebugOverlay"]
offset_left = 24.0
offset_top = 510.0
theme_override_colors/font_color = Color(0.85, 0.85, 0.85, 1)
theme_override_font_sizes/font_size = 14
text = "Clique esquerdo: mover / selecionar alvo\nClique direito: selecionar alvo\nESC: sair"

[node name="DeathOverlay" type="CanvasLayer" parent="."]

[node name="Dim" type="ColorRect" parent="DeathOverlay"]
offset_right = 1280.0
offset_bottom = 720.0
color = Color(0, 0, 0, 0.78)
mouse_filter = 2

[node name="Center" type="CenterContainer" parent="DeathOverlay"]
offset_right = 1280.0
offset_bottom = 720.0

[node name="VBox" type="VBoxContainer" parent="DeathOverlay/Center"]
theme_override_constants/separation = 18

[node name="Message" type="Label" parent="DeathOverlay/Center/VBox"]
text = "VOCÊ MORREU"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 42

[node name="Hint" type="Label" parent="DeathOverlay/Center/VBox"]
text = "Seu personagem chegou ao fim. Escolha como continuar."
horizontal_alignment = 1

[node name="Spectator" type="Button" parent="DeathOverlay/Center/VBox"]
text = "Continuar como espectador"

[node name="NewCharacter" type="Button" parent="DeathOverlay/Center/VBox"]
text = "Criar novo personagem"
